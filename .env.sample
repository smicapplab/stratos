# ==============================================================================
# STRATOS ENVIRONMENT CONFIGURATION (.env.sample)
# Copy this file to `.env` and fill in your environment-specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Transaction-mode connection pooler URL (used for app queries)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Direct session-mode connection URL (used for Drizzle schema migrations & push)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SERVER PORT & HOST (EC2 Standalone / Dev Server)
# ------------------------------------------------------------------------------
PORT=5180
HOST="0.0.0.0"
APP_URL="http://localhost:5180"

# ------------------------------------------------------------------------------
# 3. VALKEY / REDIS IN-MEMORY CACHE & PUBSUB
# ------------------------------------------------------------------------------
VALKEY_HOST="localhost"
VALKEY_PORT=6379
VALKEY_PASS=""

# ------------------------------------------------------------------------------
# 4. EMAIL PROVIDER CONFIGURATION (Optional - Choose One)
# Stratos auto-detects in order: 1) SMTP -> 2) AWS SES -> 3) Resend
# ------------------------------------------------------------------------------

# Option A: Custom SMTP Server
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Stratos <noreply@example.com>"

# Option B: AWS Simple Email Service (SES)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM="Stratos <noreply@example.com>"

# Option C: Resend API
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# 5. FILE ATTACHMENT STORAGE CONFIGURATION
# Default: Local Disk Storage (`uploads/` directory on EC2 server)
# Cloud Option: AWS S3 / Supabase Storage / Cloudflare R2
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local" # Options: "local" or "s3"
UPLOAD_DIR="uploads"

# S3 / Cloud Storage Settings (Required if STORAGE_PROVIDER="s3")
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="" # Optional: Custom S3 endpoint for Supabase Storage or Cloudflare R2
